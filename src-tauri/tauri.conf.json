{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USBLink",
  "version": "0.3.8",
  "identifier": "dev.cinit.usblink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "USBLink",
      "width": 1180,
      "height": 760,
      "minWidth": 820,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CinitDev",
    "shortDescription": "中文 USB 共享与远程连接工具",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "vendor/easytier/LICENSE-EasyTier.txt": "licenses/LICENSE-EasyTier.txt",
      "LICENSE-TAURI-TEMPLATE.txt": "licenses/LICENSE-TAURI-TEMPLATE.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "template": "installer-template.nsi",
        "customLanguageFiles": { "SimpChinese": "installer-zh.nsh" }
      }
    }
  }
}
