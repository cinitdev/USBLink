{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "USBLink",
  "version": "0.2.12",
  "identifier": "dev.cinit.usblink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "USBLink",
      "width": 1180,
      "height": 760,
      "minWidth": 820,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "windows": { "webviewInstallMode": { "type": "skip" } }
  }
}
